# Segredo usado para selar o cookie de sessão. Gere com: openssl rand -base64 32
# Obrigatório em produção: sem ele o login responde 500.
NUXT_APP_SECRET=
NUXT_ADMIN_USER_IDS=
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# Opcional: use a URL publica fixa, terminando em /auth/google.
NUXT_OAUTH_GOOGLE_REDIRECT_URL=
DATABASE_PATH=.data/blog.sqlite

# Senha do usuário inicial (dasha@dashacave.com.br), usada UMA vez no primeiro
# boot de um banco vazio. Sem ela o usuário inicial não é criado.
# Remova depois que a conta existir.
SEED_PASSWORD=

# Servidor SMTP usado para enviar os e-mails de verificação e de recuperação de
# senha. Sem NUXT_SMTP_HOST os e-mails só aparecem no console (útil em dev).
# Porta 587 usa STARTTLS; a 465 usa TLS direto.
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
# Opcional: remetente padrão. Padrão: Caverna da Dasha <nao-responda@dashacave.com.br>
# Precisa ser a conta autenticada ou um alias autorizado por ela.
NUXT_MAIL_FROM=
# Opcional: com "true", nenhum e-mail sai pelo SMTP: o conteúdo (inclusive o link)
# é impresso no console do servidor. Útil para testar os fluxos sem enviar nada.
NUXT_MAIL_CONSOLE=
# Opcional: base dos links enviados por e-mail (ex.: https://dashacave.com.br).
# Sem ela, usamos a origem da requisição.
NUXT_PUBLIC_SITE_URL=
